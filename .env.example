# Claude — https://platform.claude.com (API keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high. Higher is more thorough and slower.
REACH_EFFORT=low

# Beta: Yale login + saved plans + limits (leave empty for open local mode)
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
ALLOWED_DOMAIN=yale.edu
DAILY_PLAN_LIMIT=10
DAILY_DECK_LIMIT=15
MONTHLY_CALL_CAP=3000

# Yale NetID sign-in (CAS). Leave off until Yale ITS approves the CAS Registration
# for https://bulldog-reach.onrender.com/auth/cas/callback, then set CAS_ENABLED=1.
CAS_ENABLED=0
# CAS_URL=https://secure.its.yale.edu/cas
