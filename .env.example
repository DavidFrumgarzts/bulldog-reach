# Claude — https://platform.claude.com (API keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high. Higher is more thorough and slower.
REACH_EFFORT=low

# Beta: Yale login + saved plans + limits (leave empty for open local mode)
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
ALLOWED_DOMAIN=yale.edu
DAILY_PLAN_LIMIT=10
DAILY_DECK_LIMIT=15
MONTHLY_CALL_CAP=3000

# LinkedIn connect via Composio — https://platform.composio.dev
# 1) Settings → API Keys. 2) Auth Configs → Create → LinkedIn (OAuth2) → copy the ac_… id.
COMPOSIO_API_KEY=
COMPOSIO_LINKEDIN_AUTH_CONFIG_ID=
# Public URL Composio redirects back to (defaults to the request's host)
PUBLIC_URL=

# Optional, free: Apollo people search for the workspace (0-credit search endpoint only; returns no emails).
# Leave empty to keep it off. See docs/COSTS.md.
APOLLO_API_KEY=
